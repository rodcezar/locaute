[node name="Body" type="ColorRect" parent="Opponent"]
offset_left = -110.0
offset_top = -180.0
offset_right = 110.0
offset_bottom = 180.0
color = Color(0.784314, 0.294118, 0.294118, 1)

[node name="BlockPrompt" parent="." instance=ExtResource("2_block")]

[node name="PunchPrompt" parent="." instance=ExtResource("3_punch")]

[node name="ActionTimer" type="Timer" parent="."]
