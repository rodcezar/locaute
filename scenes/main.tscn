[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/block_prompt.tscn" id="2_block"]
[ext_resource type="PackedScene" path="res://scenes/punch_prompt.tscn" id="3_punch"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="BackgroundLayer" type="CanvasLayer" parent="."]
layer = -1

[node name="ArenaBG" type="ColorRect" parent="BackgroundLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0941176, 0.105882, 0.141176, 1)

[node name="Camera2D" type="Camera2D" parent="."]
